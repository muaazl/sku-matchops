{
  "description": "Curated golden SKUs for the classifier + business-rules pipeline. Expected labels were reviewed by hand (model mistakes are kept as misses, not snapshotted). Only fields shown to be stable across PYTHONHASHSEED values are asserted: the basic type and rule-driven GKs.",
  "min_accuracy": 0.85,
  "rules": [
    {
      "rule_id": "golden_1",
      "domain": "food",
      "priority": 1,
      "description": "We put the Seafood keyword for all the Seafood dishes except Short Eats",
      "reasoning": "",
      "condition_logic": "AND",
      "conditions": [
        {
          "condition_group": 1,
          "condition_type": "flavor_is",
          "value": "seafood",
          "negate": 0
        },
        {
          "condition_group": 2,
          "condition_type": "gk_contains",
          "value": "Short Eats",
          "negate": 1
        },
        {
          "condition_group": 3,
          "condition_type": "sku_contains",
          "value": "Seafood",
          "negate": 1
        },
        {
          "condition_group": 4,
          "condition_type": "flavor_is",
          "value": "meat",
          "negate": 1
        }
      ],
      "actions": [
        {
          "action_type": "add_gk",
          "value": "Seafood"
        }
      ]
    },
    {
      "rule_id": "golden_2",
      "domain": "food",
      "priority": 11,
      "description": "We don't put Rice for Fried Rice",
      "reasoning": "",
      "condition_logic": "AND",
      "conditions": [
        {
          "condition_group": 1,
          "condition_type": "bt_is",
          "value": "Fried Rice",
          "negate": 0
        },
        {
          "condition_group": 2,
          "condition_type": "gk_contains",
          "value": "Fried Rice",
          "negate": 0
        }
      ],
      "actions": [
        {
          "action_type": "remove_gk",
          "value": "Rice"
        }
      ]
    },
    {
      "rule_id": "golden_3",
      "domain": "food",
      "priority": 21,
      "description": "We don't put Short Eats keyword for Sweet Items",
      "reasoning": "",
      "condition_logic": "OR",
      "conditions": [
        {
          "condition_group": 1,
          "condition_type": "bt_is",
          "value": "Sweet Bun",
          "negate": 0
        },
        {
          "condition_group": 2,
          "condition_type": "bt_is",
          "value": "Sweet Crepe",
          "negate": 0
        },
        {
          "condition_group": 3,
          "condition_type": "bt_is",
          "value": "Sweet Pastry",
          "negate": 0
        },
        {
          "condition_group": 4,
          "condition_type": "bt_is",
          "value": "Sweet Pie",
          "negate": 0
        },
        {
          "condition_group": 5,
          "condition_type": "bt_is",
          "value": "Sweet Pizza",
          "negate": 0
        },
        {
          "condition_group": 6,
          "condition_type": "bt_is",
          "value": "Sweet Roll",
          "negate": 0
        }
      ],
      "actions": [
        {
          "action_type": "remove_gk",
          "value": "Short Eats"
        }
      ]
    }
  ],
