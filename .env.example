# ==============================================================================
# SKU MatchOps — Environment Configuration
# ==============================================================================

# --- Google Sheets Integration ---
# Primary Google Sheet ID containing the catalog and taxonomy tabs
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Optional Google Apps Script Webhook URL
APPS_SCRIPT_URL=

# --- PostgreSQL (shared by the Backend Gateway and the ML Engine) ---
# For local Python execution outside Docker (docker-compose.override.yml publishes 5432).
# In Docker Compose, the services are pointed at the internal 'postgres' host automatically.
DATABASE_URL=postgresql+psycopg://matchops:matchops@localhost:5432/matchops
# Credentials used by the postgres container (keep in sync with DATABASE_URL)
POSTGRES_USER=matchops
POSTGRES_PASSWORD=matchops
POSTGRES_DB=matchops
# Connection pool per process (pool_pre_ping is always on)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Rows per INSERT when bulk-writing per-SKU results
DB_BULK_CHUNK_SIZE=1000

# --- Redis (rule-cache invalidation pub/sub) ---
# For local execution outside Docker; Compose points services at redis://redis:6379/0.
# Optional: if Redis is down, workers reload rules from PostgreSQL at each job start.
REDIS_URL=redis://localhost:6379/0

# --- Decoupled ML Engine & Backend Gateway URLs ---
# For local Python execution outside Docker:
ENGINE_URL=http://localhost:8001
BACKEND_INTERNAL_URL=http://localhost:8000
# In Docker Compose, these automatically map to http://engine:8001 and http://backend:8000

# --- Vector & Lexical Search Engines ---
# In Docker Compose, these point to internal service names.
# For local Python execution outside Docker, use http://localhost:6333 and http://localhost:7700
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=meilimasterkey

# --- ONNX Optimization & Quantization ---
# Enable INT8 Quantized models (75% smaller RAM/Disk, 3-4x faster initialization)
USE_INT8_MODELS=true
# Rows per ONNX inference call (bounds RAM on large jobs) and requests per Qdrant batch call
ONNX_BATCH_SIZE=32
QDRANT_BATCH_CHUNK_SIZE=100

# --- BasicType (BT) Classifier Model Selection ---
# Options: 'arcface' (Deep Metric Learning Head) or 'logreg' (LogisticRegression)
FOOD_BT_MODEL=arcface
MARKET_BT_MODEL=arcface

# --- Cloudflare Quick Tunnel Configuration ---
# Set to 'true' to auto-launch Cloudflare tunnel
ENABLE_TUNNEL=false

# --- LLM & AI Keyword Generation ---
# Google Gemini API key used by scripts/catalog/generate_keywords.py
GEMINI_API_KEY=

